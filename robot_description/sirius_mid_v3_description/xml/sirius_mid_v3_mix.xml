<mujoco model="sirius_ax1">
    <compiler angle="radian" meshdir="../assets/"/>

    <asset>
        <mesh name="base_link" file="base_link.obj"/>
        <mesh name="difference_fr" file="difference_fr.obj"/>
        <mesh name="thigh_fr" file="thigh_fr.obj"/>
        <mesh name="shank_fr" file="shank_fr.obj"/>
        <mesh name="difference_br" file="difference_br.obj"/>
        <mesh name="thigh_br" file="thigh_br.obj"/>
        <mesh name="shank_br" file="shank_br.obj"/>
        <mesh name="difference_fl" file="difference_fl.obj"/>
        <mesh name="thigh_fl" file="thigh_fl.obj"/>
        <mesh name="shank_fl" file="shank_fl.obj"/>
        <mesh name="difference_bl" file="difference_bl.obj"/>
        <mesh name="thigh_bl" file="thigh_bl.obj"/>
        <mesh name="shank_bl" file="shank_bl.obj"/>
    </asset>

    <default>
        <default class="robot">
            <geom friction="0.6" margin="0.001" condim="1" group="3"/>
            <default class="visual">
                <geom type="mesh" contype="0" conaffinity="0" group="2"/>
            </default>

            <default class="abad">
                <!--                joint range-->
                <joint pos="0 0 0" axis="1 0 0" range="-0.785398 0.785398"/>
                <!--                control position -->
                <!--                <position ctrlrange="-0.863 0.863"/>-->
                <motor ctrlrange="-35 35"/>
            </default>
            <default class="hip">
                <joint range="-1.57 1.57"/>
                <motor ctrlrange="-35 35"/>
            </default>
            <default class="knee">
                <joint range="-2.9 2.9"/>
                <!--                output torque range, knees with larger gear ratio-->
                <motor forcerange="-86 86" ctrlrange="-86 86"/>
            </default>

            <default class="knee_f">
                <joint range="-3.15159 1.17453"/>
                <!--                output torque range, knees with larger gear ratio-->
                <motor forcerange="-45 45" ctrlrange="-45 45"/>
            </default>

            <default class="knee_r">
                <joint range="-1.17453 3.15159"/>
                <!--                output torque range, knees with larger gear ratio-->
                <motor forcerange="-45 45" ctrlrange="-45 45"/>
            </default>

            <default class="collision">
                <geom type="capsule"/>
                <default class="ffoot">
                    <geom type="sphere" size="0.03" pos="-0.07 0 -0.252" priority="1" solimp="0.015 1 0.02" condim="6"
                          friction="1.0 0.02 0.01"/>
                </default>
                <default class="hfoot">
                    <geom type="sphere" size="0.03" pos="0.07 0 -0.252" priority="1" solimp="0.015 1 0.02" condim="6"
                          friction="1.0 0.02 0.01"/>
                </default>
            </default>
        </default>
    </default>

    <worldbody>
