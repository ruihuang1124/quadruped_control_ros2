<?xml version="1.0"?>

<robot name="sirius" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:arg name="DEBUG" default="false"/>
    <xacro:arg name="robot_type" default="sirius_type"/>
    <xacro:property name="robot_type" value="$(arg robot_type)"/>
	<xacro:arg name="simulator" default="arclab_rl"/>
    <xacro:property name="simulator" value="$(arg simulator)"/>

	<xacro:include filename="$(find sirius_description)/xacro/const.xacro"/>
	<xacro:include filename="$(find sirius_description)/xacro/materials.xacro"/>
	<xacro:include filename="$(find sirius_description)/xacro/leg.xacro"/>
	<xacro:include filename="$(find sirius_description)/xacro/ros2_control_real_robot.xacro"/>


	<!-- <xacro:stairs stairs="15" xpos="0" ypos="0" zpos="0" /> -->

	<!-- Rotor related joint and link is only for demonstrate location. -->
	<!-- Actually, the rotor will rotate and the joint is not fixed. Reduction ratio should be considered. -->

	<!-- Debug mode will hung up the robot, use "true" or "false" to switch it. -->
	<xacro:if value="$(arg DEBUG)">
		<link name="world"/>
		<joint name="base_static_joint" type="fixed">
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<parent link="world"/>
			<child link="base"/>
		</joint>
	</xacro:if>

	<link name="base">
		<visual>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<geometry>
				<box size="0.001 0.001 0.001"/>
			</geometry>
		</visual>
	</link>

	<joint name="floating_base" type="fixed">
		<origin rpy="0 0 0" xyz="0 0 0"/>
		<parent link="base"/>
		<child link="trunk"/>
	</joint>

	<link name="trunk">
		<visual>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<geometry>
				<mesh filename="package://sirius_description/meshes/base_link.dae" scale="1 1 1"/>
			</geometry>
			<!-- <material name="orange"/> -->
		</visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
<!--                <mesh filename="package://dg_engineer_description/simplified_meshes/base_link.dae" scale="1 1 1"/>-->
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
        </collision>
        <collision>
            <origin rpy="0 0 0" xyz="0.418 0 0"/>
            <geometry>
                <box size="${base_head_length} ${base_head_width} ${base_head_height}"/>
            </geometry>
        </collision>
        <collision>
            <origin rpy="0 0 0" xyz="-0.4105 0 0"/>
            <geometry>
                <box size="${base_tail_length} ${base_tail_width} ${base_tail_height}"/>
            </geometry>
        </collision>
        <collision>
            <origin rpy="0 0 0" xyz="${base_contact_sphere_x} ${base_contact_sphere_y} ${base_contact_sphere_z}"/>
            <geometry>
                <sphere radius="${base_contact_sphere_radius}"/>
            </geometry>
        </collision>
        <collision>
            <origin rpy="0 0 0" xyz="${-base_contact_sphere_x} ${base_contact_sphere_y} ${base_contact_sphere_z}"/>
            <geometry>
                <sphere radius="${base_contact_sphere_radius}"/>
            </geometry>
        </collision>
        <collision>
            <origin rpy="0 0 0" xyz="${base_contact_sphere_x} ${-base_contact_sphere_y} ${base_contact_sphere_z}"/>
            <geometry>
                <sphere radius="${base_contact_sphere_radius}"/>
            </geometry>
        </collision>
        <collision>
            <origin rpy="0 0 0" xyz="${-base_contact_sphere_x} ${-base_contact_sphere_y} ${base_contact_sphere_z}"/>
            <geometry>
                <sphere radius="${base_contact_sphere_radius}"/>
            </geometry>
        </collision>

        <inertial>
            <origin rpy="0 0 0" xyz="${base_com_x} ${base_com_y} ${base_com_z}"/>
            <mass value="${base_mass}"/>
            <inertia
                    ixx="${base_ixx}" ixy="${base_ixy}" ixz="${base_ixz}"
                    iyy="${base_iyy}" iyz="${base_iyz}"
                    izz="${base_izz}"/>
        </inertial>
	</link>

    <joint name="imu_joint" type="fixed">
        <parent link="trunk"/>
        <child link="imu_link"/>
        <origin rpy="0 0 0" xyz="-0.01592 -0.06659 -0.00617"/>
    </joint>

    <link name="imu_link">
        <inertial>
            <mass value="0.001"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <box size="0.001 0.001 0.001"/>
            </geometry>
            <!-- <material name="red"/> -->
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <box size=".001 .001 .001"/>
            </geometry>
        </collision>
    </link>

    <xacro:leg prefix="FR" mirror="-1" mirror_dae="False" front_hind="1" front_hind_dae="True" simulator="${simulator}" robot_type="${robot_type}">
        <origin rpy="0 0 0" xyz="${leg_origin_x} ${-leg_origin_y} 0"/>
    </xacro:leg>

    <xacro:leg prefix="FL" mirror="1" mirror_dae="True" front_hind="1" front_hind_dae="True" simulator="${simulator}" robot_type="${robot_type}">
        <origin rpy="0 0 0" xyz="${leg_origin_x} ${leg_origin_y} 0"/>
    </xacro:leg>

    <xacro:leg prefix="RR" mirror="-1" mirror_dae="False" front_hind="-1" front_hind_dae="False" simulator="${simulator}" robot_type="${robot_type}">
        <origin rpy="0 0 0" xyz="${-leg_origin_x} ${-leg_origin_y} 0"/>
    </xacro:leg>

    <xacro:leg prefix="RL" mirror="1" mirror_dae="True" front_hind="-1" front_hind_dae="False" simulator="${simulator}" robot_type="${robot_type}">
        <origin rpy="0 0 0" xyz="${-leg_origin_x} ${leg_origin_y} 0"/>
    </xacro:leg>
</robot>
